{
  "name": "oof-ui-game-showcase",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "Packages"
      },
      "OofUiPrimitives": {
        "$path": "src"
      },
      "OofUiExamples": {
        "$path": "examples"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "Showcase": {
          "$path": "dev/Showcase.client.luau"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace"
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2,
        "Ambient": [
          0.45,
          0.46,
          0.5
        ],
        "OutdoorAmbient": [
          0.65,
          0.65,
          0.65
        ],
        "GlobalShadows": true,
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    }
  }
}
